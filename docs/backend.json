
{
  "entities": {
    "Reading": {
      "title": "Blood Sugar Reading",
      "description": "A single blood sugar measurement at a specific time.",
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "description": "Blood sugar level in mg/dL"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When the reading was taken"
        },
        "userId": {
          "type": "string",
          "description": "The UID of the user who owns this reading"
        }
      },
      "required": [
        "value",
        "timestamp",
        "userId"
      ]
    },
    "AccessRequest": {
      "title": "Access Request",
      "description": "A request from a guest to view an owner's data.",
      "type": "object",
      "properties": {
        "requesterEmail": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "denied"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["requesterEmail", "ownerEmail", "status", "timestamp"]
    },
    "SharedPermission": {
      "title": "Shared Permission",
      "description": "Record of granted access from owner to guest.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "guestEmail": { "type": "string" },
        "grantedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "ownerEmail", "guestEmail", "grantedAt"]
    }
  },
  "auth": {
    "providers": [
      "google.com"
    ]
  },
  "firestore": {
    "/readings/{readingId}": {
      "schema": "#/entities/Reading",
      "description": "Collection of blood sugar readings."
    },
    "/requests/{requestId}": {
      "schema": "#/entities/AccessRequest",
      "description": "Guest access requests."
    },
    "/permissions/{permissionId}": {
      "schema": "#/entities/SharedPermission",
      "description": "Active viewing permissions."
    }
  }
}
